<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>Order Confirmation</title>
  <style type="text/css">
    @import url("https://fonts.googleapis.com/css?family=Nunito+Sans:400,700&display=swap");

    body {
      width: 100% !important; height: 100%; margin: 0; padding: 0;
      -webkit-text-size-adjust: none; background: #f2f4f6;
      font-family: "Nunito Sans", Helvetica, Arial, sans-serif; color: #51545e;
    }
    h1 { margin: 0 0 20px; color: #333; font-size: 24px; font-weight: 700; }
    h2 { margin: 0 0 16px; color: #333; font-size: 18px; font-weight: 700; }
    p { font-size: 16px; line-height: 1.7; margin: 0 0 18px; }
    a { color: #0f7cc0; text-decoration: none; }

    .wrapper { width: 100%; padding: 30px 0; background: #f2f4f6; }
    .container { width: 570px; margin: auto; background: #fff; border-radius: 8px; overflow: hidden; }
    .logo { text-align: center; padding: 35px 20px 15px; }
    .logo img { max-width: 220px; height: auto; }
    .content { padding: 20px 40px 40px; }
    .badge { display: inline-block; padding: 6px 16px; font-size: 14px; font-weight: 700; border-radius: 20px; margin-bottom: 20px; }
    .badge-success { background: #d1fae5; color: #065f46; }

    .items-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    .items-table th { background: #f8fafc; border: 1px solid #e5e7eb; padding: 10px 12px; font-size: 13px; font-weight: 700; color: #444; text-align: left; }
    .items-table td { border: 1px solid #e5e7eb; padding: 10px 12px; font-size: 14px; }

    .totals { margin-top: 20px; width: 100%; }
    .totals td { padding: 6px 12px; font-size: 14px; }
    .totals .label { text-align: right; font-weight: 600; color: #555; width: 70%; }
    .totals .value { text-align: right; width: 30%; }
    .totals .grand-total { font-size: 18px; font-weight: 700; color: #333; border-top: 2px solid #333; padding-top: 10px; }

    .footer { text-align: left; padding: 30px 40px; font-size: 13px; color: #777; border-top: 1px solid #e5e7eb; background: #fafafa; line-height: 1.8; }
    .footer strong { color: #444; }

    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; }
      .content { padding: 25px; }
    }
  </style>
</head>
<body>
  <table class="wrapper" width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr>
      <td align="center">
        <table class="container" cellpadding="0" cellspacing="0" role="presentation">
          <tr>
            <td class="logo">
              <a href="https://medicaretraining.co.uk/" target="_blank">
                <img src="https://medicaretraining.co.uk/logo.png" alt="Medicare Training" />
              </a>
            </td>
          </tr>
          <tr>
            <td class="content">
              <h2>Thank you for your purchase, <%= name %>!</h2>

              <h2>Order Summary</h2>
              <table class="items-table" role="presentation">
                <thead>
                  <tr>
                    <th>Course</th>
                    <th style="text-align:center">Qty</th>
                    <th style="text-align:right">Unit Price</th>
                    <th style="text-align:right">Subtotal</th>
                  </tr>
                </thead>
                <tbody>
                  <% items.forEach(function(item) { %>
                  <tr>
                    <td><%= item.title %></td>
                    <td style="text-align:center"><%= item.quantity %></td>
                    <td style="text-align:right">&pound;<%= Number(item.unitPrice).toFixed(2) %></td>
                    <td style="text-align:right">&pound;<%= Number(item.subTotal).toFixed(2) %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>

              <table class="totals" role="presentation">
                <% if (discount > 0) { %>
                <tr>
                  <td class="label">Subtotal</td>
                  <td class="value">&pound;<%= Number(subtotal).toFixed(2) %></td>
                </tr>
                <tr>
                  <td class="label">Discount (<%= (discount * 100).toFixed(0) %>% off)</td>
                  <td class="value" style="color:#059669;">-&pound;<%= Number(discountedAmount).toFixed(2) %></td>
                </tr>
                <% } %>
                <tr>
                  <td class="label grand-total">Total</td>
                  <td class="value grand-total">&pound;<%= Number(totalAmount).toFixed(2) %></td>
                </tr>
              </table>

              <p style="margin-top: 30px;">
                You can access your courses anytime from your dashboard.
              </p>
              <p>Best regards,<br /><strong>Medicare Training</strong></p>
            </td>
          </tr>
          <tr>
            <td class="footer">
              <strong>Medicare Training</strong><br />
              <a href="mailto:support@medicaretraining.co.uk">support@medicaretraining.co.uk</a><br />
              <a href="https://medicaretraining.co.uk/" target="_blank">medicaretraining.co.uk</a><br /><br />
              <span style="color: #999; font-size: 12px;">
                &copy; <%= new Date().getFullYear() %> Medicare Training. All rights reserved.
              </span>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
