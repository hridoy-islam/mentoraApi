<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>New Contact Form Submission</title>

  <style type="text/css">
    @import url("https://fonts.googleapis.com/css?family=Nunito+Sans:400,700&display=swap");

    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      background: #f2f4f6;
      font-family: "Nunito Sans", Helvetica, Arial, sans-serif;
      color: #51545e;
      -webkit-text-size-adjust: none;
    }

    h1 {
      margin: 0 0 20px;
      color: #333333;
      font-size: 24px;
      font-weight: 700;
    }

    p {
      font-size: 16px;
      line-height: 1.7;
      margin: 0 0 18px;
    }

    a {
      color: #0f7cc0;
      text-decoration: none;
    }

    .wrapper {
      width: 100%;
      padding: 30px 0;
      background: #f2f4f6;
    }

    .container {
      width: 570px;
      margin: auto;
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
    }

    .logo {
      text-align: center;
      padding: 35px 20px 15px;
    }

    .logo img {
      max-width: 220px;
      height: auto;
    }

    .content {
      padding: 20px 40px 40px;
    }

    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    .info-table td {
      border: 1px solid #e5e7eb;
      padding: 12px;
      vertical-align: top;
      font-size: 15px;
    }

    .label {
      background: #f8fafc;
      font-weight: bold;
      width: 140px;
    }

    .message-box {
      white-space: pre-wrap;
      line-height: 1.7;
    }

    .footer {
      text-align: left;
      padding: 30px 40px;
      border-top: 1px solid #e5e7eb;
      color: #777777;
      font-size: 13px;
      background: #fafafa;
      line-height: 1.8;
    }

    .footer strong {
      color: #444444;
    }

    @media only screen and (max-width: 600px) {
      .container {
        width: 100% !important;
      }

      .content {
        padding: 25px;
      }

      .label {
        width: 110px;
      }
    }
  </style>
</head>

<body>

  <table class="wrapper" width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr>
      <td align="center">

        <table class="container" cellpadding="0" cellspacing="0" role="presentation">

          <!-- Logo -->
          <tr>
            <td class="logo">
              <a href="https://medicaretraining.co.uk/" target="_blank">
                <img
                  src="https://medicaretraining.co.uk/logo.png"
                  alt="Medicare Training"
                />
              </a>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td class="content">

              <h1>New Contact Form Submission</h1>

              <p>
                A new enquiry has been submitted through the
                <strong>Medicare Training</strong> contact form.
              </p>

              <table class="info-table" role="presentation">
                <tr>
                  <td class="label">Name</td>
                  <td><%= name %></td>
                </tr>

                <tr>
                  <td class="label">Email</td>
                  <td>
                    <a href="mailto:<%= email %>"><%= email %></a>
                  </td>
                </tr>

                <tr>
                  <td class="label">Subject</td>
                  <td><%= subject %></td>
                </tr>

                <tr>
                  <td class="label">Message</td>
                  <td class="message-box"><%= message %></td>
                </tr>
              </table>

              <p style="margin-top: 25px;">
                Please review this enquiry and respond to the customer as soon as
                possible.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="footer">
              <strong>Medicare Training</strong><br />
              <a href="mailto:support@medicaretraining.co.uk">support@medicaretraining.co.uk</a><br />
              <a href="https://medicaretraining.co.uk/" target="_blank">medicaretraining.co.uk</a><br /><br />
              <span style="color: #999999; font-size: 12px;">
                &copy; <%= new Date().getFullYear() %> Medicare Training. All rights reserved.
              </span>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>

</html>